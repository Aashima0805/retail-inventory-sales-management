# ==============================================================================
# RETAIL INVENTORY & SALES MANAGEMENT SYSTEM - ENVIRONMENT TEMPLATE
# Copy this file to .env and provide your actual secrets locally.
# DO NOT COMMIT THE ACTUAL .env FILE OR REAL SECRETS TO GIT.
# ==============================================================================

# Database Configuration (Supabase PostgreSQL Free Tier)
# Example: jdbc:postgresql://db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?sslmode=require
DB_URL=jdbc:postgresql://<SUPABASE_HOST>:<PORT>/<DATABASE_NAME>?sslmode=require
DB_USERNAME=<SUPABASE_DB_USER>
DB_PASSWORD=<SUPABASE_DB_PASSWORD>

# Server Configuration
SERVER_PORT=8080

# Security / JWT Configuration
# Minimum 256-bit (32 bytes) Base64 or plain string for HMAC-SHA256
JWT_SECRET=<YOUR_SECURE_RANDOM_JWT_SECRET_KEY>
JWT_EXPIRATION_MS=1800000

# CORS Allowed Origins
CORS_ALLOWED_ORIGINS=http://localhost:4200
